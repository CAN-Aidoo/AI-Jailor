# AI Jailer Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://aijailer:aijailer@localhost:5432/aijailer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your-secret-key-change-in-production

# MicroVM Engine (Linux only)
FIRECRACKER_BINARY=/usr/bin/firecracker
KERNEL_IMAGE_PATH=/var/lib/aijailer/vmlinux
ROOTFS_DIR=/var/lib/aijailer/rootfs
CELL_DATA_DIR=/var/lib/aijailer/cells
# Snapshot bundles (memory is sensitive: keep this 0700, local disk, write-protected)
SNAPSHOT_DIR=/var/lib/aijailer/snapshots

# --- Tenant secret store (envelope encryption) ---
# Generate: python -c "from aijailer.secretstore.keys import LocalKeyProvider as K; print('k1:' + K.generate_key())"
# Several keys allowed for rotation: "k1:...,k2:..." plus SECRETS_PRIMARY_KEY_ID=k2
# Unset => secret store disabled (API 503). There is no default key.
SECRETS_MASTER_KEYS=
SECRETS_PRIMARY_KEY_ID=

# --- AWS KMS as the secret store KEK (recommended for production; see SECRET_STORE.md) ---
# Needs: pip install 'aijailer[kms]' and AWS credentials from the instance/pod role (never here).
SECRETS_KMS_KEY_ID=
SECRETS_KMS_REGION=
SECRETS_KMS_ALLOWED_KEY_IDS=
SECRETS_KMS_CACHE_TTL_SECONDS=300

# Prometheus scrape token for GET /metrics (unset = endpoint disabled)
METRICS_TOKEN=
