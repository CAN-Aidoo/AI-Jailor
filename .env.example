# AI Jailer Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://aijailer:aijailer@localhost:5432/aijailer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your-secret-key-change-in-production

# MicroVM Engine (Linux only)
FIRECRACKER_BINARY=/usr/bin/firecracker
KERNEL_IMAGE_PATH=/var/lib/aijailer/vmlinux
ROOTFS_DIR=/var/lib/aijailer/rootfs
CELL_DATA_DIR=/var/lib/aijailer/cells
# Snapshot bundles (memory is sensitive: keep this 0700, local disk, write-protected)
SNAPSHOT_DIR=/var/lib/aijailer/snapshots

# --- Tenant secret store (envelope encryption) ---
# Generate: python -c "from aijailer.secretstore.keys import LocalKeyProvider as K; print('k1:' + K.generate_key())"
# Several keys allowed for rotation: "k1:...,k2:..." plus SECRETS_PRIMARY_KEY_ID=k2
# Unset => secret store disabled (API 503). There is no default key.
SECRETS_MASTER_KEYS=
SECRETS_PRIMARY_KEY_ID=

# --- AWS KMS as the secret store KEK (recommended for production; see SECRET_STORE.md) ---
# Needs: pip install 'aijailer[kms]' and AWS credentials from the instance/pod role (never here).
SECRETS_KMS_KEY_ID=
SECRETS_KMS_REGION=
SECRETS_KMS_ALLOWED_KEY_IDS=
SECRETS_KMS_CACHE_TTL_SECONDS=300

# Prometheus scrape token for GET /metrics (unset = endpoint disabled)
METRICS_TOKEN=

# Bearer token for the operator API /v1/admin/* (unset = disabled). Keep it out of tenant reach.
ADMIN_TOKEN=

# Audit log: auto (db outside dev, memory in dev) | db | memory
AUDIT_BACKEND=auto
# REQUIRED with the db backend outside dev: derives the Ed25519 key that signs audit checkpoints.
# Keep it in a secret manager, never in the database. Changing it makes older checkpoints unverifiable.
AUDIT_SIGNING_SECRET=
AUDIT_CHECKPOINT_INTERVAL_SECONDS=300

# Group commit for high-volume audit events (per-request network decisions). A hard crash loses up to the
# delay; when the queue is full the newest events are dropped and an audit_events_dropped marker is written.
AUDIT_BATCH_MAX_EVENTS=200
AUDIT_BATCH_MAX_DELAY_MS=500
AUDIT_BATCH_QUEUE_MAX=10000

# Peer links (attested cell-to-cell channels, see PEER_LINKS.md). Unset = feature off, cells cannot reach
# each other. Derives the Ed25519 key that signs peer attestations; keep it in a secret manager.
# Cells receive the matching PUBLIC key when they start: after a rotation, cells started earlier reject new
# attestations until they are restarted.
PEER_ATTESTATION_SECRET=
PEER_LINK_DEFAULT_TTL_SECONDS=3600
PEER_LINK_MAX_TTL_SECONDS=86400
PEER_LINK_MAX_OPEN_PER_TENANT=50
PEER_WAIT_SECONDS=60
PEER_SESSION_MAX_SECONDS=3600
PEER_SESSION_IDLE_SECONDS=300
PEER_SESSION_MAX_BYTES=1073741824
